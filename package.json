{
  "name": "master-javascript-learning",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "^22.20.0 || ^24.0.0" },
  "scripts": {
    "indexes": "node scripts/generate-indexes.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
